# ====================================================================
# DermaSense AI - Environment Configuration Template
# Smart India Hackathon 2025 (Team Healthnautix, PS 25049)
# ====================================================================

# Port for FastAPI Backend
PORT=8000
HOST=127.0.0.1

# Administrator Password for Epidemiological Disease Surveillance Portal
DERMASENSE_ADMIN_PASSWORD=derma_admin_2025

# Allowed CORS Origins (comma-separated list for Vite dev / production)
DERMASENSE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# File Upload Security Limits (8 MB max by default)
MAX_UPLOAD_SIZE_BYTES=8388608

# Sliding-Window Rate Limiting (per-client IP)
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECS=60

# Optional Local LLM Grounding Endpoint (Ollama - works 100% offline without it)
OLLAMA_URL=http://localhost:11434

